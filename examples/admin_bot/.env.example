# OpsMesh QQ Adapter credentials
QQ_BOTS='[{"id":"YOUR_APP_ID","secret":"YOUR_APP_SECRET","transport":"webhook","intents":{"group_and_c2c":true}}]'

# Plugin core & operator permissions
QQ_ADMIN__ENABLED=true
QQ_ADMIN__ADMIN__ADMINS='["ADMIN_MEMBER_OPENID"]'
QQ_ADMIN__AUTO_MODERATE__ENABLED=true
QQ_ADMIN__AUTO_MODERATE__ENABLED_GROUPS='["GROUP_OPENID_1"]'

# System 1: TypeSafe AI Jev calibrated detector
QQ_ADMIN__JEV__ENABLED=true
QQ_ADMIN__JEV__API_KEY="ts-your-api-key"
QQ_ADMIN__JEV__MODEL="jev-1"
QQ_ADMIN__JEV__PROXY=""

# System 2: Dual OpenAI Agents SDK (DecisionAgent + ReplyAgent)
QQ_ADMIN__LLM__ENABLED=true
QQ_ADMIN__LLM__API_KEY="sk-your-api-key"
QQ_ADMIN__LLM__BASE_URL=""
QQ_ADMIN__LLM__DECISION_MODEL="gpt-5-mini"
QQ_ADMIN__LLM__REPLY_MODEL=""
QQ_ADMIN__LLM__REPLY_TEMPERATURE=0.7

# Optional automatic join-request review
QQ_ADMIN__AUTO_APPROVE__ENABLED=false
QQ_ADMIN__AUTO_APPROVE__DEFAULT_ACTION="ignore"
QQ_ADMIN__AUTO_APPROVE__REJECT_ON_RISK_TIPS=true
QQ_ADMIN__AUTO_APPROVE__USE_JEV_REVIEW=true
