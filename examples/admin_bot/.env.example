# OpsMesh QQ Adapter credentials
QQ_BOTS='[{"app_id":"YOUR_APP_ID","app_secret":"YOUR_APP_SECRET","transport":"webhook"}]'

# Option A: Load full settings from TOML file (copy src/qq_admin/resources/config.toml)
# QQ_ADMIN_CONFIG="config.toml"

# Option B: Configure via nested QQ_ADMIN__* environment variables
QQ_ADMIN__PLUGIN__ENABLED=true
QQ_ADMIN__ADMIN__ADMINS='["ADMIN_MEMBER_OPENID"]'
QQ_ADMIN__MODERATION__ENABLED=true
QQ_ADMIN__MODERATION__ENABLED_GROUPS='["GROUP_OPENID_1"]'

# System 1: TypeSafe AI Jev
QQ_ADMIN__JEV__ENABLED=true
QQ_ADMIN__JEV__API_KEY="ts-your-api-key"
QQ_ADMIN__JEV__MODEL="jev-1"

# System 2: Dual OpenAI Agents SDK (DecisionPlanner + ReplyComposer)
QQ_ADMIN__AGENT__ENABLED=true
QQ_ADMIN__AGENT__API_KEY="sk-your-api-key"
QQ_ADMIN__AGENT__DECISION_MODEL="gpt-5-mini"
QQ_ADMIN__AGENT__REPLY_TEMPERATURE=0.7
