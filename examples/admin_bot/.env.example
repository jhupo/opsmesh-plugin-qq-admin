# OpsMesh QQ Adapter credentials
QQ_BOTS='[{"app_id":"YOUR_APP_ID","app_secret":"YOUR_APP_SECRET","transport":"webhook"}]'

# Option A: Minimal config.toml ([jev], [decision_agent], [reply_agent])
QQ_ADMIN_CONFIG="config.toml"

# Option B: Configure base models via env variables
# QQ_ADMIN_JEV__API_KEY="ts-your-api-key"
# QQ_ADMIN_JEV__MODEL="jev-1"
# QQ_ADMIN_DECISION_AGENT__API_KEY="sk-your-api-key"
# QQ_ADMIN_DECISION_AGENT__MODEL="gpt-5-mini"
# QQ_ADMIN_DECISION_AGENT__REASONING_EFFORT="low"
# QQ_ADMIN_REPLY_AGENT__API_KEY="sk-your-api-key"
# QQ_ADMIN_REPLY_AGENT__MODEL="gpt-5-mini"
# QQ_ADMIN_REPLY_AGENT__TEMPERATURE=0.7
