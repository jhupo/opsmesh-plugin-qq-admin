# OpsMesh QQ Adapter credentials
QQ_BOTS='[{"app_id":"YOUR_APP_ID","app_secret":"YOUR_APP_SECRET","transport":"webhook"}]'

# Option A: Minimal config.toml (only [jev] + [agent]; per-group module configs are persisted here online)
QQ_ADMIN_CONFIG="config.toml"

# Option B: Configure base Jev & Agent settings via env variables
# QQ_ADMIN_JEV__API_KEY="ts-your-api-key"
# QQ_ADMIN_JEV__MODEL="jev-1"
# QQ_ADMIN_AGENT__API_KEY="sk-your-api-key"
# QQ_ADMIN_AGENT__DECISION_MODEL="gpt-5-mini"
# QQ_ADMIN_AGENT__REPLY_TEMPERATURE=0.7
# QQ_ADMIN_AGENT__SESSION_MODE="fresh"
