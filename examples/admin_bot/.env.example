# OpsMesh QQ Adapter credentials
QQ_BOTS='[{"app_id":"YOUR_APP_ID","app_secret":"YOUR_APP_SECRET","transport":"webhook"}]'

# Flat plugin config (single Config model for Jev + OpenAI Responses API)
JEV_API_KEY="ts-your-api-key"
JEV_MODEL="jev-1"
